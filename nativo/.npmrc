# node_modules PLANO, no el de enlaces de pnpm.
#
# El autolinking de React Native recorre node_modules buscando los
# módulos nativos de cada dependencia, y con el árbol simbólico de pnpm
# no los encuentra: el build de iOS sale sin ellos y la app revienta al
# arrancar, sin decir por qué. Es la configuración que Expo documenta
# para pnpm.
#
# Sólo aplica adentro de nativo/. El repo web sigue con pnpm normal.
node-linker=hoisted
