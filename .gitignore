.DS_Store

# The vault folder comes from here and belongs to each machine.
# .env.example does get versioned: it is the template.
.env.local
.env*.local

# The mockup (Remotion): licensed assets and renders do not travel.
mockup/public/
mockup/out/

# The workshop for a piece: a development harness, outside the build.
# Today it holds the frame bench, which mounts N copies of a piece on
# one page. A comment can NOT go at the end of the line below: in a
# .gitignore the # only opens a comment at the start of a line, so the
# pattern would become "proto/ # ..." and would stop ignoring anything.
proto/
