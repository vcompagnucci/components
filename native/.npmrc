# A FLAT node_modules, not pnpm's tree of links.
#
# React Native's autolinking walks node_modules looking for the native
# modules of each dependency, and with pnpm's symlinked tree it does not
# find them: the iOS build comes out without them and the app blows up
# at startup, without saying why. It is the configuration Expo documents
# for pnpm.
#
# It only applies inside native/. The web repo stays on plain pnpm.
node-linker=hoisted
