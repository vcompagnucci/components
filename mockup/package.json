{
  "name": "mockup",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "studio": "remotion studio",
    "render": "remotion render SwipeableTabs out/swipeable-tabs.mp4 --crf=17",
    "still": "remotion still SwipeableTabs",
    "verify": "node scripts/verify.mjs",
    "typecheck": "tsc --noEmit",
    "render:dark": "remotion render SwipeableTabs out/swipeable-tabs-dark.mp4 --crf=17 --props='{\"fondo\":\"#1C181A\"}'",
    "render:both": "pnpm render && pnpm render:dark",
    "render:exhibition": "node scripts/exhibition.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.520",
    "@remotion/cli": "4.0.520",
    "@remotion/media-utils": "4.0.520",
    "@remotion/renderer": "4.0.520",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.520",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2"
  }
}
